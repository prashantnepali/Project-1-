# Samparka Lead Engine — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001

# API authentication secret (auto-generated if empty)
API_SECRET=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Tavily API Key (for company enrichment and research)
TAVILY_API_KEY=

# Database
DB_PATH=./db/samparka.db

# Overpass API (optional, has sensible defaults)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Gmail / Google OAuth (for email campaigns and replies)
# Create at: https://console.cloud.google.com > APIs & Services > Credentials
# Enable Gmail API, create OAuth 2.0 Client ID (Web Application)
# Add http://localhost:3001/auth/google/callback as authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URL=http://localhost:3001/auth/google/callback
