# Samparka Lead Engine — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001

# Tavily API Key (for company enrichment and research)
TAVILY_API_KEY=

# Database
DB_PATH=./db/samparka.db

# Overpass API (optional, has sensible defaults)
OVERPASS_URL=https://overpass-api.de/api/interpreter
